 {
  "v": 1,
  "kind": "pca-action-def",
  "verb": "stripe.charge",
  "aliases": [
   "charge_customer",
   "bill"
  ],
  "title": "Charge a customer",
  "description": "Charge a customer. Refundable in practice, but a charge is treated as final.",
  "effects": [
   "pay"
  ],
  "resource": {
   "type": "stripe.customer",
   "id": {
    "prefix": "cus_",
    "class": "any_safe",
    "len": [
     8,
     64
    ]
   },
   "scope": "one"
  },
  "params": {
   "amount": {
    "type": "integer",
    "role": "money.amount",
    "min": 1,
    "max": 10000000000,
    "unit": {
     "kind": "money",
     "ccy": "USD",
     "exp": 2
    },
    "provenance_min": "first_party"
   },
   "customer": {
    "type": "string",
    "max_len": 128,
    "role": "id.stripe.customer"
   },
   "idempotency_key": {
    "type": "string",
    "max_len": 128
   }
  },
  "reversibility": "irreversible",
  "blast": {
   "radius": "tenant",
   "ppm": 900000
  },
  "idempotency": {
   "mode": "key_param",
   "param": "idempotency_key"
  },
  "examples": [
   {
    "params": {
     "customer": "cus_12345678",
     "amount": 2500,
     "idempotency_key": "k_1"
    },
    "expect": "escalate"
   }
  ],
  "review": {
   "state": "authored"
  },
  "since": "0.5.0"
 },
